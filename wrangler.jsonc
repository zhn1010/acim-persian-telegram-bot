{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acim-persian-telegram-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acim-alerts-db",
      "database_id": "d7e4a354-42f0-423f-a4ac-fed456d215a3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_BASE_URL": "https://acim-persian-telegram-bot.saeed-bots.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
